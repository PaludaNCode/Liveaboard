__pycache__/
*.py[cod]
.venv/
venv/

# Raw page snapshots are the scrape's audit trail, but they are large and
# regenerate daily. Committing them would add megabytes a week to the history
# for evidence that only matters while a parse failure is being diagnosed.
# CI keeps them as build artifacts instead.
data/snapshots/

.DS_Store

# Published beside the page, generated at build time — the dataset is
# already committed under data/, and a second copy per refresh would double
# what the repository grows by to hold two identical files.
site/data/

# The PADI import's raw store. Kept locally so a re-parse never needs a
# re-crawl -- 307 responses, 290 requests against somebody else's server --
# but not in history: 13MB rewritten whole on every refresh, against
# archive.json's 1.8MB. What it holds is stable, an entry bar and a dive
# count rather than a price that is gone tomorrow, so yesterday's copy is
# worth far less here than archive.json's is there.
data/padi_raw.json
